# Copy this file to .env and fill in your real values. .env is gitignored —
# never commit real credentials. These are used only against Webull's
# sandbox host (api.sandbox.webull.com), never production.

WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# Optional: pin a specific sandbox paper account. If left blank, the mirror
# auto-discovers the first EQUITY-capable account from your credentials'
# account list on startup and logs which one it picked.
WEBULL_ACCOUNT_ID=
